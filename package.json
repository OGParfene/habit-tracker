{
  "name": "habit-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite --host 0.0.0.0 --open /app.html",
    "build": "vite build --base=./ && node scripts/cache-build.js",
    "test:browser": "playwright test",
    "build:pages": "npm run build && node scripts/publish-static.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
